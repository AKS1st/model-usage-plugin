{
  "name": "model-usage-plugin",
  "version": "0.16.2",
  "description": "Per-model token usage, cost estimation and DeepSeek account balance for the DeepSeek Harness Web UI.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "src",
    "tests",
    "scripts",
    "cordis.patch.yml",
    "docs"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "verify": "node scripts/verify.mjs",
    "preview": "node scripts/preview.mjs",
    "preview:shot": "node scripts/preview.mjs --shot",
    "preview:measure": "node scripts/preview.mjs --measure",
    "shots:docs": "node scripts/docs-shots.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "dsh-plugin",
    "tokens",
    "usage",
    "cost",
    "balance"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AKS1st/model-usage-plugin.git"
  }
}
